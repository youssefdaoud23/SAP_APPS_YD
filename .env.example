# Server
PORT=8080

# Recommended when the Ubuntu service is reachable by other machines.
# The browser will show its standard username/password prompt.
APP_STUDIO_USER=admin
APP_STUDIO_PASSWORD=change_this_to_a_long_random_password

# Optional persistent workspace storage on Ubuntu.
# Use an absolute path for systemd or Docker deployments.
WORKSPACE_FILE=/opt/invarture-app-studio/data/workspace.json

# Optional: allow HTTP SAP endpoints outside localhost for lab environments only.
# Keep false in production.
SAP_ALLOW_HTTP=false

# Define one or more SAP/API connections as JSON.
# Secrets are referenced by environment-variable name and are never sent to the browser.
SAP_CONNECTIONS_JSON=[{"id":"sap-dev","name":"SAP DEV","type":"OData V2","baseUrl":"https://sap-dev.example.com/sap/opu/odata/sap/ZMY_SERVICE_SRV/","auth":"basic","usernameEnv":"SAP_DEV_USER","passwordEnv":"SAP_DEV_PASSWORD"}]

# Example Basic credentials
SAP_DEV_USER=replace_me
SAP_DEV_PASSWORD=replace_me

# Bearer example:
# SAP_CONNECTIONS_JSON=[{"id":"sap-api","name":"SAP API","type":"OData V4","baseUrl":"https://example.com/sap/opu/odata4/.../","auth":"bearer","tokenEnv":"SAP_API_TOKEN"}]
# SAP_API_TOKEN=replace_me

# OAuth2 client-credentials example:
# SAP_CONNECTIONS_JSON=[{"id":"sap-btp","name":"SAP BTP","type":"REST","baseUrl":"https://api.example.com/","auth":"oauth2-client-credentials","tokenUrl":"https://auth.example.com/oauth/token","clientIdEnv":"SAP_CLIENT_ID","clientSecretEnv":"SAP_CLIENT_SECRET","scope":"my.scope"}]
# SAP_CLIENT_ID=replace_me
# SAP_CLIENT_SECRET=replace_me
