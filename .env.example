# Invarture App Studio - local/Docker defaults
PORT=8081

# Authentication mode: local, basic or oidc.
# local is intended only for local development and grants Platform Admin.
AUTH_MODE=local

# HTTP Basic protection. Used when AUTH_MODE=basic.
APP_STUDIO_USER=
APP_STUDIO_PASSWORD=

# OIDC / Microsoft Entra ID. Used when AUTH_MODE=oidc.
# APP_BASE_URL must be the externally reachable App Studio URL.
APP_BASE_URL=
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SESSION_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
OIDC_USERNAME_CLAIM=preferred_username
OIDC_DISPLAY_NAME_CLAIM=name
OIDC_EMAIL_CLAIM=email
OIDC_GROUPS_CLAIM=groups
OIDC_ALLOWED_ALGS=RS256
OIDC_SESSION_TTL_SECONDS=28800
OIDC_CLOCK_SKEW_SECONDS=60
OIDC_COOKIE_SECURE=true
OIDC_AUTO_PROVISION=false
OIDC_DEFAULT_ROLE=viewer
OIDC_BOOTSTRAP_ADMINS=
# Set true only for local automated tests with an HTTP OIDC provider.
OIDC_ALLOW_HTTP=false

# V0.6+ shared persistence.
# Docker Compose uses PostgreSQL by default.
POSTGRES_PASSWORD=
WORKSPACE_STORAGE=postgres

# Optional external PostgreSQL settings.
# DATABASE_URL=
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_MAX=10

# File storage remains available as a fallback for direct/local Node usage.
WORKSPACE_FILE=/app/data/workspace.json

# Optional: allow HTTP SAP endpoints outside localhost for lab environments only.
SAP_ALLOW_HTTP=false

# Start with no SAP connections. Add real connections after the platform is running.
SAP_CONNECTIONS_JSON=[]

# SAP connection secrets should be referenced by environment variable name from SAP_CONNECTIONS_JSON.
# Example variable names you can define locally when needed:
# SAP_DEV_USER=
# SAP_DEV_PASSWORD=
# SAP_API_TOKEN=
# SAP_CLIENT_ID=
# SAP_CLIENT_SECRET=
